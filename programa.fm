!stil flamecode
<flamecode>
manifest! = "Iniciando prueba final...":
@contador = "1":
laos = aus="1" ~ bis="3" [
    ja @contador == "2" [
        manifest! = "El contador va en 2, es par.":
    ] aber [
        manifest! = "El contador NO va en 2.":
    ]
    @contador = @contador H "1":
]
manifest! = "Prueba terminada.":
</flamecode>
